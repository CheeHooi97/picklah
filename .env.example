ENV=development
PORT=2001
HOST=0.0.0.0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=picklah
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=picklah
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC
POSTGRES_AUTO_MIGRATE=true
PICKLAH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost,https://localhost,capacitor://localhost

# Google backend authorization-code flow, matching Musecards' configuration.
PICKLAH_SITE_URL=http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: defaults to PICKLAH_SITE_URL + /v1/auth/oauth/google/callback.
GOOGLE_OAUTH_REDIRECT_URL=
