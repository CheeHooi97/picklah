# Leave empty for same-origin browser deployments using an API proxy.
VITE_API_BASE_URL=https://picklah.my

# Use the canonical HTTPS web origin when building mobile apps.
VITE_PUBLIC_URL=https://picklah.my

# Native Android AdMob. Blank IDs use Google's demo app/banner by default.
# Mobile builds load .env.mobile; Gradle reads the app ID from the same files.
# Override native app ID with -PPICKLAH_ADMOB_APP_ID=... if needed.
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
VITE_ADS_USE_TEST_IDS=true
# Optional local browser preview of the reserved banner slot.
VITE_ADS_PREVIEW=false
